```cshtml
@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Lead Details";
}

<div class="container py-4">
    <h2>Lead Details</h2>
    <p class="text-muted">View complete lead information.</p>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Lead ID</dt>
                <dd class="col-sm-9">@Model.LeadId</dd>

                <dt class="col-sm-3">Lead Name</dt>
                <dd class="col-sm-9">@Model.LeadName</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@Model.CompanyName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Source</dt>
                <dd class="col-sm-9">@Model.Source</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">@Model.Status</span>
                </dd>

                <dt class="col-sm-3">Expected Value</dt>
                <dd class="col-sm-9">@Model.ExpectedValue.ToString("N2")</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.LeadId"
               class="btn btn-primary">Edit Lead</a>

            <a asp-action="Index"
               class="btn btn-secondary">Back to Leads</a>
        </div>
    </div>
</div>
```