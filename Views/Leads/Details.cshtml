@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Lead Details"; }
<h1 class="h2">Lead Details</h1>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Lead code</dt><dd class="col-sm-9">@Model.LeadCode</dd>
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.LeadName</dd>
        <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
        <dt class="col-sm-3">Email / Phone</dt><dd class="col-sm-9">@Model.Email · @Model.Phone</dd>
        <dt class="col-sm-3">Source / Status</dt><dd class="col-sm-9">@Model.Source · @Model.Status</dd>
        <dt class="col-sm-3">Expected value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C")</dd>
        <dt class="col-sm-3">History</dt><dd class="col-sm-9">@Model.FollowUps.Count follow-ups, @Model.Activities.Count activities, @Model.Opportunities.Count opportunities</dd>
        @if (Model.ConvertedCustomer != null)
        { <dt class="col-sm-3">Converted customer</dt><dd class="col-sm-9"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId">@Model.ConvertedCustomer.CustomerName</a></dd> }
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary">Edit</a>
    @if (Model.Status == "Qualified")
    {
        <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" class="d-inline">
            <button class="btn btn-success" type="submit" onclick="return confirm('Convert this lead to a customer and create a sales opportunity when it has an expected value?')">Convert to customer</button>
        </form>
    }
    <a asp-action="Delete" asp-route-id="@Model.LeadId" class="btn btn-outline-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to leads</a>
</div></div>
