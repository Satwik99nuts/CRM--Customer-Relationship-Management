@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Delete Lead"; }
<h1 class="h2">Delete Lead</h1>
<div class="alert alert-warning">Deleting this lead is allowed only when it has no follow-ups, activities, or opportunities. Related history is never cascade-deleted.</div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="card"><div class="card-body">
    <p>Delete <strong>@Model.LeadName</strong> (@Model.Email)?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.LeadId" />
        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this lead?')">Delete lead</button>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-secondary">Cancel</a>
    </form>
</div></div>
