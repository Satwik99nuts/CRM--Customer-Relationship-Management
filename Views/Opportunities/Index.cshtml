@model IEnumerable<AcxiomCRM.Models.Opportunity>

@{
    ViewData["Title"] = "Opportunities";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Sales Opportunities</h1>
            <p class="text-muted">Manage deals and track your sales pipeline.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Add Opportunity</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-6"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search opportunities, customers, stages or status..." /></div>
        <div class="col-md-2"><select name="stage" class="form-select"><option value="">All stages</option>@foreach(var x in new[]{"Qualification","Proposal","Negotiation","Won","Lost"}){<option value="@x" selected="@(ViewBag.Stage == x)">@x</option>}</select></div>
        <div class="col-md-2"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var x in new[]{"Open","Won","Lost"}){<option value="@x" selected="@(ViewBag.Status == x)">@x</option>}</select></div>
        <div class="col-md-2"><button type="submit" class="btn btn-dark w-100">Filter</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Opportunity</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Expected Close</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OpportunityName</td>
                            <td>@item.Customer?.CustomerName</td>
                            <td>@item.Amount.ToString("N2")</td>
                            <td>@item.Stage</td>
                            <td>@item.Probability%</td>
                            <td>@item.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-secondary">@item.Status</span>
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId"
                                   class="btn btn-sm btn-outline-info">View</a>
                                <a asp-action="Edit" asp-route-id="@item.OpportunityId"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.OpportunityId"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            No opportunities found. Add your first deal.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav aria-label="Opportunity pages"><ul class="pagination">@for(var i=1;i<=(int)ViewBag.PageCount;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewData["Search"]" asp-route-stage="@ViewBag.Stage" asp-route-status="@ViewBag.Status">@i</a></li>}</ul></nav>
</div>
