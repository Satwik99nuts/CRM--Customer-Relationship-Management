@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Add Opportunity";
}

<div class="container py-4">
    <h1>Add Opportunity</h1>
    <p class="text-muted">Enter the details of the sales deal.</p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="OpportunityName" class="form-label">Opportunity Name</label>
            <input asp-for="OpportunityName" class="form-control" required />
            <span asp-validation-for="OpportunityName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerId" class="form-label">Customer ID</label>
            <input asp-for="CustomerId" type="number" min="1" class="form-control" required />
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">Deal Amount</label>
            <input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" required />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Stage" class="form-label">Sales Stage</label>
            <select asp-for="Stage" class="form-select" required>
                <option value="Qualification">Qualification</option>
                <option value="Proposal">Proposal</option>
                <option value="Negotiation">Negotiation</option>
                <option value="Won">Won</option>
                <option value="Lost">Lost</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Probability" class="form-label">Win Probability (%)</label>
            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" required />
            <span asp-validation-for="Probability" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date</label>
            <input asp-for="ExpectedCloseDate" type="date" class="form-control" required />
            <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select" required>
                <option value="Open">Open</option>
                <option value="Won">Won</option>
                <option value="Lost">Lost</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save Opportunity</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}