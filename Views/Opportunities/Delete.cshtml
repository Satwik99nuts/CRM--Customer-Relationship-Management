@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Delete Opportunity";
}

<div class="container py-4">
    <h1>Delete Opportunity</h1>

    <div class="alert alert-warning">
        If follow-ups reference this opportunity, deletion will be blocked so that history is preserved.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>@Model.OpportunityName</h5>
            <p><strong>Customer:</strong> @Model.Customer?.CustomerName</p>
            <p><strong>Amount:</strong> @Model.Amount.ToString("N2")</p>
            <p><strong>Stage:</strong> @Model.Stage</p>
            <p><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post">
        <input type="hidden" asp-for="OpportunityId" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
