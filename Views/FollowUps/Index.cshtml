@model IEnumerable<AcxiomCRM.Models.FollowUp>

@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Follow-Ups</h1>
            <p class="text-muted">Schedule and track customer interactions.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Schedule Follow-Up</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Index" method="get" class="input-group mb-4">
        <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search follow-ups..." />
        <button class="btn btn-dark" type="submit">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Customer</th>
                    <th>Lead</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Subject</td>
                        <td>@item.Type</td>
                        <td>@(item.Customer?.CustomerName ?? "-")</td>
                        <td>@(item.Lead?.LeadName ?? "-")</td>
                        <td>@item.FollowUpDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge bg-secondary">@item.Status</span></td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.FollowUpId"
                               class="btn btn-sm btn-outline-info">View</a>
                            <a asp-action="Edit" asp-route-id="@item.FollowUpId"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.FollowUpId"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No follow-ups found.</p>
    }
</div>