@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="container py-4">
    <h1>Schedule Follow-Up</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Subject" class="form-label">Subject</label>
            <input asp-for="Subject" class="form-control" required />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FollowUpDate" class="form-label">Date and Time</label>
            <input asp-for="FollowUpDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Type</label>
            <select asp-for="Type" class="form-select">
                <option value="Call">Call</option>
                <option value="Meeting">Meeting</option>
                <option value="Email">Email</option>
                <option value="Task">Task</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerId" class="form-label">Customer (optional)</label>
            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                <option value="">-- Select Customer --</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="LeadId" class="form-label">Lead (optional)</label>
            <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                <option value="">-- Select Lead --</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Planned">Planned</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Remarks" class="form-label">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save Follow-Up</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}