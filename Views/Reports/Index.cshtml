@model AcxiomCRM.ViewModels.ReportViewModel
@{ ViewData["Title"] = "Reports"; }
<div class="d-flex justify-content-between align-items-start"><div><h1 class="h2">Reports</h1><p class="text-muted">Filtered, role-scoped CRM reports with CSV export.</p></div>
<a asp-action="Export" asp-route-report="@Model.Report" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-owner="@Model.Owner" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Export CSV</a></div>
<form method="get" class="card card-body mb-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-2 align-items-end">
<div class="col-md-3"><label class="form-label">Report</label><select name="report" class="form-select"><option value="customers" selected="@(Model.Report == "customers")">Customers</option><option value="leads" selected="@(Model.Report == "leads")">Leads</option><option value="conversion" selected="@(Model.Report == "conversion")">Lead conversion</option><option value="follow-ups" selected="@(Model.Report == "follow-ups")">Follow-ups</option><option value="opportunities" selected="@(Model.Report == "opportunities")">Opportunities</option><option value="pipeline" selected="@(Model.Report == "pipeline")">Sales pipeline</option>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <option value="user-activity" selected="@(Model.Report == "user-activity")">User activity</option> }@if (User.IsInRole("Admin")) { <option value="audit" selected="@(Model.Report == "audit")">Audit</option> }</select></div>
<div class="col-md-3"><label class="form-label">Search</label><input name="search" value="@Model.Search" class="form-control" /></div><div class="col-md-2"><label class="form-label">Status / stage</label><input name="status" value="@Model.Status" class="form-control" /></div><div class="col-md-2"><label class="form-label">Owner ID</label><input name="owner" value="@Model.Owner" class="form-control" /></div><div class="col-md-1"><label class="form-label">From</label><input name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-1"><label class="form-label">To</label><input name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-12"><button class="btn btn-primary">Apply filters</button> <a asp-action="Index" asp-route-report="@Model.Report" class="btn btn-outline-secondary">Clear</a></div>
</div></form>
<p class="small text-muted">@Model.TotalCount matching records · Page @Model.Page of @Model.PageCount</p>
<div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Name / Action</th><th>Category</th><th>Status</th><th>Owner / User</th><th>Related</th><th>Amount</th><th>Date</th><th>Details</th></tr></thead><tbody>
@foreach (var row in Model.Rows) { <tr><td>@row.Name</td><td>@row.Category</td><td>@row.Status</td><td>@row.Owner</td><td>@row.Related</td><td>@(row.Amount?.ToString("C") ?? "—")</td><td>@row.Date?.ToString("yyyy-MM-dd")</td><td>@row.Details</td></tr> }
@if (!Model.Rows.Any()) { <tr><td colspan="8" class="text-center text-muted">No matching report data.</td></tr> }
</tbody></table></div>
<nav aria-label="Report pages"><ul class="pagination">@for (var i = 1; i <= Model.PageCount; i++) { <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-report="@Model.Report" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-owner="@Model.Owner" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-page="@i">@i</a></li> }</ul></nav>
