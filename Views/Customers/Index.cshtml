
@model IEnumerable<AcxiomCRM.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Customers</h1>
        <p class="text-muted">Manage your customer database.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Customer</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input name="search" value="@ViewBag.Search"
               class="form-control"
               placeholder="Search name, email, phone or company..." />
        <button class="btn btn-dark" type="submit">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CustomerName</td>
                <td>@c.CompanyName</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td><span class="badge bg-success">@c.Status</span></td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@c.CustomerId"
                       class="btn btn-sm btn-outline-info">View</a>
                    <a asp-action="Edit" asp-route-id="@c.CustomerId"
                       class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.CustomerId"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">No customers found. Add your first customer!</div>
}
