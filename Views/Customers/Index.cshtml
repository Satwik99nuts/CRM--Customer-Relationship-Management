
@model IEnumerable<AcxiomCRM.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Customers</h1>
        <p class="text-muted">Manage your customer database.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Customer</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-7"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, email, phone or company..." /></div>
    <div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><option value="Active" selected="@(ViewBag.Status == "Active")">Active</option><option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option></select></div>
    <div class="col-md-2"><button class="btn btn-dark w-100" type="submit">Filter</button></div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CustomerName</td>
                <td>@c.CompanyName</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td><span class="badge bg-success">@c.Status</span></td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@c.CustomerId"
                       class="btn btn-sm btn-outline-info">View</a>
                    <a asp-action="Edit" asp-route-id="@c.CustomerId"
                       class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.CustomerId"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">No customers found. Add your first customer!</div>
}
<nav aria-label="Customer pages"><ul class="pagination">@for (var i = 1; i <= (int)ViewBag.PageCount; i++) { <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">@i</a></li> }</ul></nav>
