
@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>

<div class="alert alert-warning">
    If this customer has any sales or activity history, the application will deactivate the customer to preserve those records.
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@Model.CustomerName</h5>
        <p class="mb-1">@Model.CompanyName</p>
        <p class="mb-1">@Model.Email</p>
        <p class="mb-0">@Model.Phone</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this customer? Linked history will be retained by deactivation.')">Delete or deactivate</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
