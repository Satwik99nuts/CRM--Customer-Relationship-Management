@model AcxiomCRM.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }
<h1 class="h2">Reset Password</h1><p class="text-muted">Set a new password; the previous password is never displayed.</p>
<form asp-action="ResetPassword" method="post" class="card card-body col-lg-7"><input asp-for="UserId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control"/><span asp-validation-for="NewPassword" class="text-danger"></span>
    <label asp-for="ConfirmPassword" class="form-label mt-3"></label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    <div class="mt-3"><button class="btn btn-primary">Reset password</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
