@model AcxiomCRM.ViewModels.CreateUserViewModel
@{ ViewData["Title"] = "Create User"; }
<h1 class="h2">Create User</h1>
<form asp-action="Create" method="post" class="card card-body col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control"/><span asp-validation-for="DisplayName" class="text-danger"></span>
    <label asp-for="Email" class="form-label mt-3"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span>
    <label asp-for="Role" class="form-label mt-3"></label><select asp-for="Role" class="form-select"><option>Admin</option><option>Manager</option><option>Sales Executive</option></select><span asp-validation-for="Role" class="text-danger"></span>
    <label asp-for="Password" class="form-label mt-3"></label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password" class="text-danger"></span>
    <label asp-for="ConfirmPassword" class="form-label mt-3"></label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    <div class="mt-3"><button class="btn btn-primary">Create user</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
