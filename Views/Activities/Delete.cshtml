@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container py-4">
    <h1>Delete Activity</h1>

    <div class="alert alert-warning">
        Are you sure you want to permanently delete this activity?
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@Model.Subject</h5>
            <p><strong>Type:</strong> @Model.ActivityType</p>
            <p><strong>Date:</strong> @Model.ActivityDate.ToString("dd MMM yyyy HH:mm")</p>
            <p><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.ActivityId" method="post">
        <input type="hidden" asp-for="ActivityId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
