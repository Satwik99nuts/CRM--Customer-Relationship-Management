@model IEnumerable<AcxiomCRM.Models.Activity>
@{ ViewData["Title"] = "Activities"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Activities</h1><p class="text-muted">Track calls, meetings, emails, and tasks.</p></div><a asp-action="Create" class="btn btn-primary">+ Add activity</a></div>
<form asp-action="Index" method="get" class="row g-2 mb-3"><div class="col-md-3"><label class="form-label">Search</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Subject or related record" /></div><div class="col-md-2"><label class="form-label">Type</label><select name="type" class="form-select"><option value="">All types</option>@foreach(var x in new[]{"Call","Meeting","Email","Task"}) { <option value="@x" selected="@(ViewBag.Type == x)">@x</option> }</select></div><div class="col-md-2"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var x in new[]{"Planned","In Progress","Completed","Cancelled"}) { <option value="@x" selected="@(ViewBag.Status == x)">@x</option> }</select></div>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <div class="col-md-2"><label class="form-label">Assigned user</label><select name="assignedTo" asp-items="ViewBag.OwnerOptions" class="form-select"><option value="">All</option></select></div> }<div class="col-md-2"><label class="form-label">From</label><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" /></div><div class="col-md-2"><label class="form-label">To</label><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" /></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-dark">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead class="table-dark"><tr><th>Subject</th><th>Type</th><th>Related</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Subject</td><td>@item.ActivityType</td><td>@(item.Customer?.CustomerName ?? item.Lead?.LeadName ?? "—")</td><td>@item.ActivityDate.ToString("dd MMM yyyy HH:mm")</td><td>@item.Status</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.ActivityId" class="btn btn-sm btn-outline-info">View</a> <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@item.ActivityId" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted">No matching activities.</td></tr>}</tbody></table></div>
<nav aria-label="Activity pages"><ul class="pagination">@for(var i=1;i<=(int)ViewBag.PageCount;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-type="@ViewBag.Type" asp-route-status="@ViewBag.Status" asp-route-assignedTo="@ViewBag.AssignedTo" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">@i</a></li>}</ul></nav>
